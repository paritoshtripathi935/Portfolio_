---
import { skies, skyStyle } from "../data/skies";

type Stat = { value: string; label: string };
type Props = {
  title: string;
  blurb: string;
  stats: Stat[];
  slug?: string;
  backHref?: string;
  backLabel?: string;
};
const {
  title,
  blurb,
  stats,
  slug,
  backHref = "/#work",
  backLabel = "all work",
} = Astro.props;
---

<header class="max-w-5xl mx-auto px-6 pt-12 pb-12">
  <a
    href={backHref}
    class="inline-flex items-center gap-2 label-wide text-[11px] text-[var(--color-ink-muted)] hover:text-[var(--color-saffron)] transition-colors"
  >
    ← {backLabel}
  </a>

  <div
    class="sys-card page-hero mt-6"
    style={skyStyle((slug && skies[slug]) || skies.default)}
    transition:name={slug ? `card-${slug}` : undefined}
  >
    <div class="sky page-hero-sky" aria-hidden="true"><span class="sky-ridge"></span></div>
    <div class="sys-top">
      <span class="label-wide text-[10px] md:text-xs">Case study</span>
    </div>
    <div class="sys-body">
      <h1
        class="sys-title page-hero-title display-serif"
        transition:name={slug ? `card-${slug}-title` : undefined}
      >
        {title}
      </h1>
      <p class="mt-5 text-lg text-[var(--color-ink-muted)] leading-relaxed max-w-3xl">{blurb}</p>

      <dl class="sys-metrics sys-metrics-wide">
        {
          stats.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</header>
