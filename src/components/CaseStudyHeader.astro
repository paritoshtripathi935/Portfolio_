---
import { skies, skyStyle } from "../data/skies";
import { experience } from "../data/experience";

type Stat = { value: string; label: string };
type Props = {
  title: string;
  blurb: string;
  stats: Stat[];
  slug?: string;
  backHref?: string;
  backLabel?: string;
  ownership?: string;
};
const {
  title,
  blurb,
  stats,
  slug,
  backHref = "/#work",
  backLabel = "all work",
  ownership = "Sole owner, design to production · ~30-engineer company",
} = Astro.props;

// Where and when this was built, from the role that lists this case study.
const job = slug ? experience.find((e) => e.caseStudies?.some((c) => c.href === `/work/${slug}`)) : undefined;
---

<header class="max-w-5xl mx-auto px-6 pt-12 pb-12">
  <a
    href={backHref}
    class="inline-flex items-center gap-2 label-wide text-[11px] text-[var(--color-ink-muted)] hover:text-[var(--color-saffron)] transition-colors"
  >
    ← {backLabel}
  </a>

  <div
    class="sys-card page-hero mt-6"
    style={skyStyle((slug && skies[slug]) || skies.default)}
    transition:name={slug ? `card-${slug}` : undefined}
  >
    <div class="sky page-hero-sky" aria-hidden="true"><span class="sky-ridge"></span></div>
    <div class="sys-top">
      <span class="label-wide text-[11px] md:text-xs">Case study{job && ` · ${job.company} · ${job.role} · ${job.period}`}</span>
    </div>
    <div class="sys-body">
      <h1
        class="sys-title page-hero-title display-serif"
        transition:name={slug ? `card-${slug}-title` : undefined}
      >
        {title}
      </h1>
      <p class="mt-5 text-lg text-[var(--color-ink-muted)] leading-relaxed max-w-3xl">{blurb}</p>
      <p class="mt-3 label-wide text-[11px] text-[var(--color-saffron)]">{ownership}</p>

      <dl class="sys-metrics sys-metrics-wide">
        {
          stats.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</header>
