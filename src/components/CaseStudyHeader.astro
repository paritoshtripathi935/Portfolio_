---
type Stat = { value: string; label: string };
type Props = {
  eyebrow: string;
  title: string;
  blurb: string;
  stats: Stat[];
  slug?: string;
  backHref?: string;
  backLabel?: string;
};
const {
  eyebrow,
  title,
  blurb,
  stats,
  slug,
  backHref = "/#work",
  backLabel = "all work",
} = Astro.props;
---

<header class="max-w-4xl mx-auto px-6 pt-16 pb-12">
  <a
    href={backHref}
    class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-[var(--color-ink-muted)] hover:text-[var(--color-saffron)] transition-colors"
  >
    ← {backLabel}
  </a>

  <div
    class="mt-8 font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-saffron)]"
    transition:name={slug ? `card-${slug}-eyebrow` : undefined}
  >
    {eyebrow}
  </div>
  <h1
    class="mt-3 font-serif text-5xl md:text-6xl tracking-tight text-[var(--color-ink)]"
    transition:name={slug ? `card-${slug}-title` : undefined}
  >
    {title}
  </h1>
  <p class="mt-5 text-lg text-[var(--color-ink-muted)] leading-relaxed max-w-2xl">{blurb}</p>

  <dl class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-px bg-[var(--color-border)] border border-[var(--color-border)] rounded-xl overflow-hidden">
    {
      stats.map((s) => (
        <div class="bg-[var(--color-surface)] p-5">
          <dt class="font-serif text-2xl text-[var(--color-saffron)]">{s.value}</dt>
          <dd class="text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)] mt-1">{s.label}</dd>
        </div>
      ))
    }
  </dl>
</header>
