---
import { site } from "../data/site";

const path = Astro.url.pathname;
const isHome = path === "/";

// `stage` ties an item to a home-page section so the active state follows scroll (see global.css).
const items = [
  { href: "/", label: "Home", stage: "hero", icon: "home", active: false },
  { href: "/#work", label: "Work", stage: "case-studies", icon: "work", active: path.startsWith("/work/") },
  { href: "/#timeline", label: "Timeline", stage: "timeline", icon: "timeline", active: path.startsWith("/experience/") },
  { href: "/#projects", label: "Projects", stage: "projects", icon: "projects", active: false },
  { href: "/#contact", label: "Contact", stage: "contact", icon: "contact", active: false },
  { href: "/recruiter", label: "Recruiters", stage: "", icon: "recruiter", active: path.startsWith("/recruiter"), desktopOnly: true },
];
---

<nav class="rail" aria-label="Primary">
  {
    items.map((it) => (
      <a
        href={it.href}
        class:list={["rail-item", { "rail-desktop-only": it.desktopOnly }]}
        data-stage={isHome ? it.stage : undefined}
        data-active={it.active ? "true" : undefined}
        aria-current={it.active ? "page" : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {it.icon === "home" && <><path d="M3 11.5 12 4l9 7.5" /><path d="M5 10v10h14V10" /><path d="M10 20v-6h4v6" /></>}
          {it.icon === "work" && <><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 13h18" /></>}
          {it.icon === "timeline" && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
          {it.icon === "projects" && <><path d="m8 8-4 4 4 4" /><path d="m16 8 4 4-4 4" /><path d="m14 5-4 14" /></>}
          {it.icon === "contact" && <><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" /><path d="m3 7 9 6 9-6" /></>}
          {it.icon === "recruiter" && <><path d="M12 3 14.2 9.8 21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2z" /></>}
        </svg>
        <span>{it.label}</span>
      </a>
    ))
  }
  <div class="rail-spacer" aria-hidden="true"></div>
  <a href={site.resume} target="_blank" rel="noopener" class="rail-item rail-desktop-only">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><path d="M14 3v6h6" /><path d="M12 12v6" /><path d="m9 15 3 3 3-3" />
    </svg>
    <span>Resume</span>
  </a>
</nav>
