---
import { formatRelativeTime } from "../lib/github";

type Project = {
  name: string;
  blurb: string;
  language: string;
  stars: number;
  pushedAt: string | null;
  archived: boolean;
  href: string;
  liveUrl: string | null;
};

type Props = {
  project: Project;
};

const { project: p } = Astro.props;

const langColor: Record<string, string> = {
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  Python: "#3572A5",
  Go: "#00ADD8",
  CSS: "#563d7c",
  HTML: "#e34c26",
  "Jupyter Notebook": "#DA5B0B",
  Java: "#b07219",
  Shell: "#89e051",
};
---

<div class="spotlight reveal group flex flex-col gap-3 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-border-strong)] bg-[var(--color-surface)] p-5 transition-colors">
  <div class="flex items-start justify-between gap-3">
    <a
      href={p.href}
      target="_blank"
      rel="noopener"
      class="font-mono text-base text-[var(--color-ink)] group-hover:text-[var(--color-saffron)] transition-colors"
    >
      {p.name}
    </a>
    <div class="flex items-center gap-2 shrink-0">
      {p.stars > 0 && (
        <span class="font-mono text-xs text-[var(--color-ink-faint)] flex items-center gap-1">
          ★ {p.stars}
        </span>
      )}
      {p.archived && (
        <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)] border border-[var(--color-border)] rounded px-1.5 py-0.5">
          archived
        </span>
      )}
    </div>
  </div>

  <p class="text-sm text-[var(--color-ink-muted)] leading-relaxed flex-1">{p.blurb}</p>

  <div class="flex items-center justify-between gap-2 text-xs">
    <span class="flex items-center gap-2">
      <span
        class="inline-block w-2 h-2 rounded-full"
        style={`background:${langColor[p.language] || "#888"}`}
      />
      <span class="font-mono text-[var(--color-ink-muted)]">{p.language}</span>
      {p.pushedAt && (
        <span class="font-mono text-[var(--color-ink-faint)]">
          · {formatRelativeTime(p.pushedAt)}
        </span>
      )}
    </span>

    <div class="flex items-center gap-1.5">
      {p.liveUrl && (
        <a
          href={p.liveUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-wider px-2 py-1 rounded-md border border-[var(--color-saffron)] text-[var(--color-saffron)] hover:bg-[var(--color-saffron)] hover:text-black transition-colors"
        >
          Live ↗
        </a>
      )}
      <a
        href={p.href}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-wider px-2 py-1 rounded-md border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:border-[var(--color-border-strong)] hover:text-[var(--color-ink)] transition-colors"
      >
        Code ↗
      </a>
    </div>
  </div>
</div>
