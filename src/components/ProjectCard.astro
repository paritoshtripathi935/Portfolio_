---
import { formatRelativeTime } from "../lib/github";
import { skyFor, skyStyle } from "../data/skies";

type Project = {
  name: string;
  blurb: string;
  language: string;
  stars: number;
  pushedAt: string | null;
  archived: boolean;
  href: string;
  liveUrl: string | null;
};

type Props = {
  project: Project;
  index?: number;
};

const { project: p, index = 0 } = Astro.props;

const langColor: Record<string, string> = {
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  Python: "#3572A5",
  Go: "#00ADD8",
  CSS: "#563d7c",
  HTML: "#e34c26",
  "Jupyter Notebook": "#DA5B0B",
  Java: "#b07219",
  Shell: "#89e051",
};
---

<div class="sys-card proj-card" data-motion-card style={skyStyle(skyFor("", index))}>
  <div class="sky proj-sky" aria-hidden="true"><span class="sky-ridge"></span></div>
  <div class="sys-top">
    <span class="label-wide text-[10px] flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full" style={`background:${langColor[p.language] || "#888"}`} />
      {p.language}
    </span>
    <span class="flex items-center gap-2">
      {p.archived && <span class="proj-chip">archived</span>}
      {p.stars > 0 && <span class="proj-chip">★ {p.stars}</span>}
    </span>
  </div>

  <div class="sys-body">
    <h3 class="sys-title proj-title display-serif">
      <a href={p.href} target="_blank" rel="noopener" class="proj-link"><span class="fit-line proj-fit" data-fit-max="56"><span>{p.name}</span></span></a>
    </h3>
    <p class="sys-sub flex-1">{p.blurb}</p>

    <div class="mt-5 pt-4 border-t border-[var(--color-border)] flex items-center justify-between gap-2">
      <span class="font-mono text-[11px] text-[var(--color-ink-faint)]">
        {p.pushedAt ? `pushed ${formatRelativeTime(p.pushedAt)}` : ""}
      </span>
      <div class="flex items-center gap-1.5">
        {p.liveUrl && (
          <a href={p.liveUrl} target="_blank" rel="noopener" class="proj-btn proj-btn-live">Live ↗</a>
        )}
        <a href={p.href} target="_blank" rel="noopener" class="proj-btn">Code ↗</a>
      </div>
    </div>
  </div>
</div>
