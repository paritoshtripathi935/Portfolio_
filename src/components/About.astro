---
import { site } from "../data/site";
import Terminal from "./Terminal.astro";
---

<section id="about" class="max-w-6xl mx-auto px-6 py-24 scroll-mt-20">
  <div class="reveal label-wide text-xs text-[var(--color-saffron)] mb-5">— About</div>
  <h2 class="reveal title-heavy text-[clamp(3.25rem,10vw,8rem)] text-[var(--color-ink)]">
    Design. Ship.<br /><span class="text-[var(--color-saffron)]">Scale.</span>
  </h2>

  <p class="reveal mt-10 max-w-3xl text-lg md:text-xl text-[var(--color-ink-muted)] leading-relaxed">
    I'm <span class="text-[var(--color-ink)]">{site.name}</span> — a backend engineer with 4 years building microservices, distributed systems, and event-driven architectures in Python and Go. Currently Software Engineer II at <span class="text-[var(--color-ink)]">Sharpsell</span>, building a multi-tenant ClickHouse + dbt analytics platform. Previously at <span class="text-[var(--color-ink)]">Parspec</span> (saga-based inventory, public API, ERP integrations, ephemeral environments) and <span class="text-[var(--color-ink)]">Anakin (YC&nbsp;S21)</span>. I design and ship backend systems end-to-end — from technical design and ADRs through production, scaling, and observability.
  </p>

  <div class="reveal mt-6 max-w-3xl flex items-baseline gap-3 text-sm">
    <span class="label-wide text-[10px] text-[var(--color-saffron)] shrink-0">Now ›</span>
    <span class="text-[var(--color-ink-muted)] leading-relaxed">{site.now}</span>
  </div>

  <Terminal />
</section>
