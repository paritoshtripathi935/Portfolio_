---
import { site } from "../data/site";
import Terminal from "./Terminal.astro";
---

<section id="about" class="max-w-6xl mx-auto px-6 py-24 scroll-mt-20">
  <div class="reveal label-wide text-xs text-[var(--color-saffron)] mb-5">— About</div>
  <h2 class="reveal title-heavy text-[clamp(3.25rem,10vw,8rem)] text-[var(--color-ink)]">
    Design. Ship.<br /><span class="text-[var(--color-saffron)]">Scale.</span>
  </h2>

  <p class="reveal mt-10 max-w-3xl text-lg md:text-xl text-[var(--color-ink-muted)] leading-relaxed">
    I'm <span class="text-[var(--color-ink)]">{site.name}</span>, a backend engineer with 4 years of distributed systems in Python and Go. Now at <span class="text-[var(--color-ink)]">Sharpsell</span>, building a multi-tenant ClickHouse + dbt analytics platform and the CDC pipelines that feed it. Before that, <span class="text-[var(--color-ink)]">Parspec</span> and <span class="text-[var(--color-ink)]">Anakin (YC&nbsp;S21)</span>. I take systems from design doc to production, and keep them running.
  </p>

  <Terminal />
</section>
