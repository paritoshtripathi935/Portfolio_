---
import { site } from "../data/site";
import CommandPalette from "./CommandPalette.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="topbar sticky top-0 z-50 border-b border-[var(--color-border)]">
  <nav class="h-14 px-4 md:px-6 flex items-center justify-between gap-4">
    <a href="/" class="flex items-baseline gap-2 shrink-0 group" aria-label="Home">
      <span class="[font-family:var(--font-heavy)] font-bold text-lg tracking-tight text-[var(--color-ink)]">Paritosh</span>
      <span class="font-serif italic text-[var(--color-saffron)] text-lg group-hover:text-[var(--color-saffron-light)] transition-colors">{site.hindiName.split(" ")[0]}</span>
    </a>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <CommandPalette />
      <a
        href="/journey"
        class="cta-recruiter inline-flex items-center gap-1.5 rounded-md border border-[var(--color-saffron)] text-[var(--color-saffron)] hover:bg-[var(--color-saffron)] hover:text-black font-semibold text-sm px-3.5 md:px-4 h-9 transition-colors"
      >
        <span aria-hidden="true" class="text-[0.65em]">▶</span>
        <span>Journey</span>
      </a>
    </div>
  </nav>
</header>
