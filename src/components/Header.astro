---
import { site } from "../data/site";
import CommandPalette from "./CommandPalette.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/#work", label: "work" },
  { href: "/#timeline", label: "timeline" },
  { href: "/#projects", label: "projects" },
  { href: "/#contact", label: "contact" },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-bg)]/60 border-b border-[var(--color-border)]">
  <nav class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between gap-4">
    <a href="/" class="font-serif text-lg tracking-tight text-[var(--color-ink)] hover:text-[var(--color-saffron)] transition-colors shrink-0">
      {site.hindiName}
    </a>
    <ul class="hidden md:flex items-center gap-1 text-sm text-[var(--color-ink-muted)]">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="px-3 py-2 rounded-md hover:text-[var(--color-ink)] hover:bg-[var(--color-surface)] transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2">
      <a
        href="/recruiter"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border-strong)] hover:border-[var(--color-saffron)] hover:text-[var(--color-saffron)] text-[var(--color-ink-muted)] text-xs font-mono uppercase tracking-[0.18em] px-3 py-1.5 transition-colors"
      >
        For recruiters
        <span class="text-[var(--color-saffron)]">→</span>
      </a>
      <ThemeToggle />
      <CommandPalette />
    </div>
  </nav>
</header>
