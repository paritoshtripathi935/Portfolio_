---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer mt-24 border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 pt-12 pb-6 flex flex-col md:flex-row gap-6 md:items-end md:justify-between">
    <div>
      <div class="label-wide text-[10px] text-[var(--color-saffron)] mb-2">{site.status}</div>
      <div class="title-heavy text-2xl text-[var(--color-ink)]">{site.role}.</div>
    </div>
    <nav class="flex items-center gap-6 text-sm text-[var(--color-ink-muted)]" aria-label="Footer">
      <a href={site.github} target="_blank" rel="noopener" class="hover:text-[var(--color-saffron)] transition-colors">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-[var(--color-saffron)] transition-colors">LinkedIn</a>
      <a href={`mailto:${site.email}`} class="hover:text-[var(--color-saffron)] transition-colors">Email</a>
      <a href={site.resume} target="_blank" rel="noopener" class="hover:text-[var(--color-saffron)] transition-colors">Resume</a>
      <span class="font-mono text-xs text-[var(--color-ink-faint)]">© {year}</span>
    </nav>
  </div>
  <div class="footer-mark" aria-hidden="true">
    <span class="fit-line footer-fit display-serif"><span>{site.name}</span></span>
  </div>
</footer>
