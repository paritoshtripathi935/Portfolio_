---
import SectionHeader from "./SectionHeader.astro";
import { site } from "../data/site";
import { skies, skyStyle } from "../data/skies";

type Case = {
  href: string;
  title: string;
  domain: string;
  subtitle: string;
  metrics: { v: string; l: string }[];
  stack: string[];
  featured?: boolean;
};

const cases: Case[] = [
  {
    href: "/work/atlas",
    title: "Atlas",
    domain: "Data platform",
    subtitle: "Multi-tenant ClickHouse + dbt analytics platform fed by zero-downtime Postgres CDC — replaced legacy Python ETLs and oversized OLAP instances.",
    metrics: [
      { v: "20×", l: "faster nightly ELT" },
      { v: "1–2s", l: "query latency" },
      { v: "85%", l: "DB cost cut" },
      { v: "100+", l: "tenants" },
    ],
    stack: ["ClickHouse", "dbt", "PeerDB", "Postgres", "ECS", "AWS CDK", "MCP"],
    featured: true,
  },
  {
    href: "/work/iris",
    title: "Iris",
    domain: "Developer platform",
    subtitle: "Per-branch ephemeral environments. PR open to live URL in 3.8 min, host-header routed on a shared ALB.",
    metrics: [
      { v: "1,567", l: "builds" },
      { v: "98.5%", l: "build success" },
      { v: "88.1%", l: "end-to-end" },
      { v: "7×", l: "DAU growth" },
    ],
    stack: ["FastAPI", "ECS Fargate", "ALB", "CodeBuild", "ECR", "Route53", "Postgres"],
  },
  {
    href: "/work/argus",
    title: "Argus",
    domain: "Distributed consistency",
    subtitle: "Saga with compensating transactions and Redis-backed per-SKU locks behind the inventory ingestion path.",
    metrics: [
      { v: "3.9M", l: "writes" },
      { v: "7,800", l: "manufacturers" },
      { v: "30%", l: "MoM growth" },
      { v: "407K", l: "peak day" },
    ],
    stack: ["Django REST", "DynamoDB", "Redis", "Saga", "Per-SKU locks"],
  },
  {
    href: "/work/ariadne",
    title: "Ariadne",
    domain: "Search & ranking",
    subtitle: "Soft-filtering search with weighted ranking, match-strength buckets, and ML image similarity under per-tier latency budgets.",
    metrics: [
      { v: "21%", l: "accuracy lift" },
      { v: "1.5s", l: "p90 (top 50)" },
      { v: "5×", l: "mounting weight" },
      { v: "3", l: "match buckets" },
    ],
    stack: ["Elasticsearch", "OpenSearch", "Vector search", "Python", "ML similarity"],
  },
  {
    href: "/work/proteus",
    title: "Proteus",
    domain: "Data pipeline",
    subtitle: "Config-driven FastAPI service that replaced per-team custom compilers — JSONPath configs, dual-queue SQS + DLQ, multi-sink writes.",
    metrics: [
      { v: "200 GB", l: "peak day" },
      { v: "100+", l: "concurrent tasks" },
      { v: "3d → 4h", l: "client onboarding" },
      { v: "99.95%", l: "availability" },
    ],
    stack: ["Python", "FastAPI", "SQS", "ECS", "MongoDB", "BigQuery", "S3"],
  },
  {
    href: "/work/hydra",
    title: "Hydra",
    domain: "Device orchestration",
    subtitle: "Hybrid Pixel + Genymotion automation platform with affinity scheduling and runtime Frida injection.",
    metrics: [
      { v: "10", l: "concurrent sessions" },
      { v: "100+", l: "devices managed" },
      { v: "Hybrid", l: "on-prem + cloud" },
      { v: "Frida", l: "runtime hooks" },
    ],
    stack: ["Python", "Go", "ECS", "SQS", "PostgreSQL", "MongoDB", "Frida", "Genymotion"],
  },
];
---

<section id="work" class="max-w-6xl mx-auto px-6 py-24 scroll-mt-20">
  <SectionHeader
    eyebrow="Selected work"
    title="Six systems."
    titleAccent="End to end."
    blurb="Each one designed, shipped, and run in production. Click in for architecture, decisions, and the numbers."
  />

  <div class="sys-grid grid md:grid-cols-2 lg:grid-cols-3 gap-5" data-motion-grid>
    {
      cases.map((c, i) => {
        const slug = c.href.split("/").pop()!;
        return (
          <a
            href={c.href}
            transition:name={`card-${slug}`}
            class:list={["sys-card group", { "sys-featured md:col-span-2": c.featured }]}
            style={skyStyle(skies[slug] ?? skies.default)}
          >
            <div class="sky" aria-hidden="true">
              <span class="sky-ridge"></span>
            </div>
            <div class="sys-top">
              <span class="label-wide text-[10px]">{String(i + 1).padStart(2, "0")} · {c.domain}</span>
              <span class="sys-arrow" aria-hidden="true">↗</span>
            </div>

            <div class="sys-body">
              <h3 class="sys-title display-serif" transition:name={`card-${slug}-title`}>{c.title}</h3>
              <p class="sys-sub">{c.subtitle}</p>

              <dl class:list={["sys-metrics", { "sys-metrics-wide": c.featured }]}>
                {c.metrics.map((m) => (
                  <div>
                    <dt>{m.v}</dt>
                    <dd>{m.l}</dd>
                  </div>
                ))}
              </dl>

              <div class="sys-stack">
                {c.stack.map((s) => <span>{s}</span>)}
              </div>
            </div>
          </a>
        );
      })
    }

    <div class="sys-card sys-cta md:col-span-2" style={skyStyle(skies.default)}>
      <div class="sky sky-full" aria-hidden="true"><span class="sky-ridge"></span></div>
      <div class="sys-body sys-cta-body">
        <span class="label-wide text-[10px] text-[var(--color-cream)]/80">Short on time?</span>
        <p class="title-heavy text-3xl md:text-5xl text-[var(--color-cream)]">The 30-second version.</p>
        <div class="flex flex-wrap gap-3 mt-2">
          <a href="/recruiter" class="btn-pill">For recruiters</a>
          <a href={site.resume} target="_blank" rel="noopener" class="btn-ghost">Resume ↗</a>
        </div>
      </div>
    </div>
  </div>
</section>



<script>
  import { initCardMotion } from "../lib/cardMotion";
  initCardMotion();
</script>
