---
type Props = {
  eyebrow: string;
  title: string;
  blurb?: string;
};
const { eyebrow, title, blurb } = Astro.props;
---

<div class="reveal mb-10">
  <div class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-saffron)] mb-3">
    — {eyebrow}
  </div>
  <h2 class="font-serif text-3xl md:text-5xl tracking-tight text-[var(--color-ink)]">{title}</h2>
  {blurb && <p class="mt-3 max-w-2xl text-[var(--color-ink-muted)]">{blurb}</p>}
</div>
