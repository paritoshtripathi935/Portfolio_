---
import { site } from "../data/site";
import { skies, skyStyle } from "../data/skies";
---

<section id="contact" class="max-w-6xl mx-auto px-6 py-24 scroll-mt-20">
  <div class="sys-card contact-panel reveal" style={skyStyle(skies.default)}>
    <div class="sky sky-full" aria-hidden="true"><span class="sky-ridge"></span></div>
    <div class="contact-body">
      <span class="label-wide text-[11px] text-[var(--color-cream)]">— Contact</span>
      <h2 class="display-serif contact-title">Let's build<br />something.</h2>
      <p class="max-w-xl text-lg text-[var(--color-cream)] leading-relaxed drop-shadow-[0_1px_8px_rgba(0,0,0,0.5)]">
        The fastest way to reach me is email. I read every message — even the ones that look like recruiter spam.
      </p>
      <a href={`mailto:${site.email}`} class="contact-email title-heavy">{site.email}</a>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href={`mailto:${site.email}`} class="btn-pill">Email me</a>
        <a href={site.linkedin} target="_blank" rel="noopener" class="btn-ghost">LinkedIn ↗</a>
        <a href={site.github} target="_blank" rel="noopener" class="btn-ghost">GitHub ↗</a>
      </div>
    </div>
  </div>
</section>
