---
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Toggle dark mode"
  title="Toggle theme"
  class="inline-flex items-center justify-center w-9 h-9 rounded-md border border-[var(--color-border)] hover:border-[var(--color-border-strong)] text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] bg-[var(--color-surface)] transition-colors shrink-0"
>
  <svg
    id="theme-icon-sun"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg
    id="theme-icon-moon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
</button>

<script is:inline>
  const setupThemeToggle = () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";

    const sun = document.getElementById("theme-icon-sun");
    const moon = document.getElementById("theme-icon-moon");

    const sync = () => {
      const dark = document.documentElement.classList.contains("dark");
      if (sun) sun.classList.toggle("hidden", dark);
      if (moon) moon.classList.toggle("hidden", !dark);
    };
    sync();

    btn.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      document.documentElement.style.colorScheme = dark ? "dark" : "light";
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch (_) {}
      sync();
    });
  };

  setupThemeToggle();
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
