---
import SectionHeader from "./SectionHeader.astro";
import { domains } from "../data/domains";

const eraLabel: Record<string, string> = {
  parspec: "Parspec",
  anakin: "Anakin",
};
---

<section id="engineering" class="max-w-6xl mx-auto px-6 py-24 scroll-mt-20">
  <SectionHeader
    eyebrow="Range"
    title="What I work on"
    blurb="Click a domain to expand. Spans Parspec (Software Engineer II) and Anakin (founding-team Software Engineer I)."
  />

  <div class="grid md:grid-cols-2 gap-3">
    {
      domains.map((d) => (
        <details
          class="spotlight reveal group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] open:border-[var(--color-border-strong)] transition-colors"
        >
          <summary class="cursor-pointer list-none p-5 flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1.5">
                <h3 class="text-lg font-medium text-[var(--color-ink)] group-open:text-[var(--color-saffron)] transition-colors">
                  {d.title}
                </h3>
                <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)] border border-[var(--color-border)] rounded-full px-2 py-0.5">
                  {eraLabel[d.era]}
                </span>
              </div>
              <p class="text-sm text-[var(--color-ink-muted)] leading-relaxed">{d.blurb}</p>
            </div>
            <span class="font-mono text-xs text-[var(--color-ink-faint)] shrink-0 mt-1 group-open:rotate-45 transition-transform">
              +
            </span>
          </summary>
          <div class="px-5 pb-5">
            <ul class="space-y-2 border-t border-[var(--color-border)] pt-4">
              {d.items.map((item) => (
                <li class="flex items-baseline gap-3 text-sm pl-4 relative before:content-['→'] before:absolute before:left-0 before:text-[var(--color-saffron)]/70">
                  <span class="text-[var(--color-ink-muted)] leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </details>
      ))
    }
  </div>
</section>
