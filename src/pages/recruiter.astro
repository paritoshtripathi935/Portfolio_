---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { skies, skyStyle } from "../data/skies";

const wins = [
  {
    metric: "20×",
    unit: "faster ELT",
    title: "Atlas · ClickHouse + dbt analytics platform",
    blurb:
      "Replaced legacy Python ETLs across 100+ tenants — nightly runs 5h → 15min, queries 15s+ → 1–2s, and 85% lower database cost (~$25K/yr) after retiring RDS OLAP instances.",
    href: "/work/atlas",
    sky: "atlas",
  },
  {
    metric: "3.9M+",
    unit: "writes",
    title: "Argus · saga + per-SKU locks",
    blurb:
      "Go saga-based ingestion keeping DynamoDB and OpenSearch consistent, with conditional-write locks serializing 3.9M+ concurrent writes across 7,800+ manufacturers at p99 under 5 ms.",
    href: "/work/argus",
    sky: "argus",
  },
  {
    metric: "4h → 8min",
    unit: "setup time",
    title: "Iris · per-branch ephemeral environments",
    blurb:
      "Internal platform spinning up 100+ isolated PR environments. Cut review setup 95%, lifted team velocity 30%, drove 7× DAU growth on the surface.",
    href: "/work/iris",
    sky: "iris",
  },
];

const facts = [
  { k: "Role", v: "Backend / distributed systems engineer" },
  { k: "Current", v: "Software Engineer II · Sharpsell (Jun 2026 → present)" },
  { k: "Before that", v: "Software Engineer II · Parspec (Apr 2025 → Jun 2026)" },
  { k: "Earlier", v: "Founding eng · Anakin (YC S21) · Engineer of the Quarter Q3 '24" },
  { k: "Experience", v: "4 yrs full-time backend" },
  { k: "Stack", v: "Python · Go · FastAPI · Django · PostgreSQL · ClickHouse · DynamoDB · OpenSearch · AWS" },
  { k: "Education", v: "B.Tech CS (Data Science) · Bennett University" },
  { k: "Location", v: "Bangalore" },
];
---

<Base title="Paritosh Tripathi — for recruiters (30-second version)">
  <section class="max-w-5xl mx-auto px-6 pt-14 pb-24 md:pt-20">
    <div class="reveal flex items-center gap-2.5 label-wide text-[11px] text-[var(--color-ink-muted)] mb-5">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-saffron)] opacity-50"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-saffron)]"></span>
      </span>
      <span>30-second version · for recruiters</span>
    </div>

    <h1 class="reveal display-serif text-[clamp(4rem,13vw,8.5rem)] text-[var(--color-ink)]">{site.name}</h1>
    <p class="reveal label-wide text-xs text-[var(--color-saffron)] mt-4 mb-10">{site.role}</p>

    <!-- TL;DR card -->
    <div class="reveal sys-card page-hero mb-14" style={skyStyle(skies.sharpsell)}>
      <div class="sky mini-sky" aria-hidden="true"><span class="sky-ridge"></span></div>
      <div class="sys-top"><span class="label-wide text-[10px]">TL;DR</span></div>
      <div class="sys-body">
        <dl class="grid grid-cols-1 md:grid-cols-[max-content_1fr] gap-x-10 gap-y-3.5 text-[15px] mt-2">
          {
            facts.map((f) => (
              <>
                <dt class="label-wide text-[10.5px] text-[var(--color-ink-faint)] md:pt-1">{f.k}</dt>
                <dd class="text-[var(--color-ink)]">{f.v}</dd>
              </>
            ))
          }
        </dl>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.resume} target="_blank" rel="noopener" class="btn-pill">Resume ↗</a>
          <a href={`mailto:${site.email}`} class="btn-outline">Email me</a>
          <a href={site.linkedin} target="_blank" rel="noopener" class="btn-outline">LinkedIn ↗</a>
        </div>
      </div>
    </div>

    <!-- Wins -->
    <div class="reveal mb-6">
      <div class="label-wide text-xs text-[var(--color-saffron)] mb-3">— Pick one</div>
      <h2 class="title-heavy text-[clamp(2.25rem,5vw,3.75rem)] text-[var(--color-ink)]">Three things that travel.</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-5" data-motion-grid>
      {
        wins.map((w, i) => (
          <a href={w.href} class="sys-card" style={skyStyle(skies[w.sky] ?? skies.default)}>
            <div class="sky mini-sky" aria-hidden="true"><span class="sky-ridge"></span></div>
            <div class="sys-top">
              <span class="label-wide text-[10px]">0{i + 1}</span>
              <span class="sys-arrow" aria-hidden="true">↗</span>
            </div>
            <div class="sys-body">
              <div class="sys-title rec-metric display-serif">{w.metric}</div>
              <div class="label-wide text-[10.5px] text-[var(--color-saffron)] mt-2">{w.unit}</div>
              <h3 class="mt-4 font-semibold text-[var(--color-ink)]">{w.title}</h3>
              <p class="sys-sub">{w.blurb}</p>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Quiet escape hatch -->
    <div class="reveal mt-14 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-[var(--color-border)]">
      <p class="label-wide text-[11px] text-[var(--color-ink-faint)]">want the long version?</p>
      <a href="/" class="btn-outline">See the full portfolio →</a>
    </div>
  </section>

  <script>
    import { initCardMotion } from "../lib/cardMotion";
    initCardMotion();
  </script>
</Base>
