---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · Paritosh Tripathi">
  <section class="max-w-6xl mx-auto px-6 py-32">
    <div class="label-wide text-xs text-[var(--color-saffron)] mb-5">— 404</div>
    <h1 class="title-heavy text-[clamp(3rem,9vw,7rem)] text-[var(--color-ink)]">
      This page<br /><span class="text-[var(--color-saffron)]">isn't here.</span>
    </h1>
    <p class="mt-8 max-w-xl text-lg text-[var(--color-ink-muted)]">
      The link may be old or mistyped. The work is still where it was.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/#work" class="btn-pill">See the work</a>
      <a href="/" class="btn-ghost">Home</a>
      <button type="button" class="btn-ghost" data-cmdk-open>Search ⌘K</button>
    </div>
  </section>
  <script>
    // Reuse the header's palette trigger rather than duplicating its logic.
    document.querySelector("[data-cmdk-open]")?.addEventListener("click", () => document.getElementById("cmdk-trigger")?.click());
  </script>
</Base>
