---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { experience } from "../data/experience";
import { skies, skyStyle } from "../data/skies";

// Oldest first: the journey reads forward in time.
const jobs = [...experience].reverse();
const cases = jobs.flatMap((j) => (j.caseStudies ?? []).map((c) => ({ ...c, company: j.company })));
const nameLines = site.name.toUpperCase().split(" ");

const skills = [
  { k: "Languages", v: "Python · Go · Java · SQL" },
  { k: "Backend", v: "Django · FastAPI · REST · gRPC · OpenAPI" },
  { k: "Data", v: "PostgreSQL · ClickHouse · DynamoDB · OpenSearch · Redis · BigQuery" },
  { k: "Distributed systems", v: "Sagas · distributed locks · event-driven design · idempotency · backpressure" },
  { k: "Cloud", v: "AWS ECS · Lambda · SQS · Aurora · Docker · Kubernetes · Terraform" },
  { k: "AI tooling", v: "LLM agents · MCP servers · evals · Claude Code" },
];

// Scene titles feed the progress bar labels; `hold` is seconds on screen after the scene has animated in.
const scenes = [
  { id: "title", label: "Intro", hold: 1.6 },
  { id: "education", label: "Education", hold: 2.4 },
  ...jobs.map((j) => ({ id: j.slug, label: j.company.replace(/ \(.*\)/, ""), hold: 3.2 })),
  { id: "work", label: "Selected work", hold: 2.8 },
  { id: "skills", label: "What I do", hold: 2.8 },
  { id: "outro", label: "Say hello", hold: 0 },
];
---

<Base title={`The journey · ${site.name}`} description={`${site.name}'s journey from university to ${jobs.at(-1)?.company}, as an automated presentation.`} bare>
  <div id="journey" class="journey" aria-roledescription="presentation">
    <section class="scene" data-scene="title" data-hold={scenes[0].hold} aria-label="Intro">
      <div class="dawn" data-a="fade"></div>
      <div class="scene-inner title-inner">
        <p class="kicker" data-a="up"><span class="hi">{site.hindiName.split(" ")[0]}</span> presents</p>
        <h1 class="big-name" aria-label={site.name}>
          {nameLines.map((word) => (
            <span class="line" aria-hidden="true">
              <span class="line-inner">{[...word].map((ch) => <span class="ch" data-a="rise">{ch}</span>)}</span>
            </span>
          ))}
        </h1>
        <p class="kicker kicker-end" data-a="scramble">The journey</p>
      </div>
    </section>

    <section class="scene" data-scene="education" data-hold={scenes[1].hold} aria-label="Education">
      <div class="sky sky-full scene-sky" style={skyStyle(skies.default)} data-a="sky" aria-hidden="true"><span class="sky-ridge"></span></div>
      <span class="ghost" data-ghost aria-hidden="true">Bennett</span>
      <div class="scene-inner">
        <p class="kicker" data-a="scramble">01 · Where it started</p>
        <h2 class="headline" data-split="chars">Bennett University</h2>
        <p class="lede" data-split="words">B.Tech in Computer Science, specialising in Data Science.</p>
        <p class="chips" data-a="up"><span>Computer Science</span><span>Data Science</span></p>
      </div>
    </section>

    {jobs.map((j, i) => (
      <section class="scene" data-scene={j.slug} data-hold={scenes[2 + i].hold} aria-label={j.company}>
        <div class="sky sky-full scene-sky" style={skyStyle(skies[j.slug] ?? skies.default)} data-a="sky" aria-hidden="true"><span class="sky-ridge"></span></div>
        <span class="ghost" data-ghost aria-hidden="true">{j.company.replace(/ \(.*\)/, "")}</span>
        <div class="scene-inner">
          <p class="kicker" data-a="scramble">{String(i + 2).padStart(2, "0")} · {j.period}</p>
          <h2 class="headline" data-split="chars">{j.company}</h2>
          <p class="role" data-a="up">{j.role}{j.location && ` · ${j.location}`}</p>
          <p class="lede summary" data-split="words">{j.summary}</p>
          {j.highlights && (
            <dl class="metrics">
              {j.highlights.map((h) => (
                <div data-a="metric">
                  <dt data-count>{h.value}</dt>
                  <dd>{h.label}</dd>
                </div>
              ))}
            </dl>
          )}
          {j.caseStudies && (
            <p class="chips" data-a="up">
              {j.caseStudies.map((c) => <span>{c.name}</span>)}
            </p>
          )}
        </div>
      </section>
    ))}

    <section class="scene" data-scene="work" data-hold={scenes.at(-3)!.hold} aria-label="Selected work">
      <div class="dawn dawn-soft" data-a="fade"></div>
      <span class="ghost" data-ghost aria-hidden="true">Systems</span>
      <div class="scene-inner">
        <p class="kicker" data-a="scramble">{String(jobs.length + 2).padStart(2, "0")} · Selected work</p>
        <h2 class="headline" data-split="chars">{cases.length} systems.<br /><span class="accent">End to end.</span></h2>
        <ul class="case-grid">
          {cases.map((c) => (
            <li data-a="tile" style={skyStyle(skies[c.href.split("/").pop()!] ?? skies.default)}>
              <span class="case-name">{c.name}</span>
              <span class="case-co">{c.company}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="scene" data-scene="skills" data-hold={scenes.at(-2)!.hold} aria-label="What I do">
      <div class="dawn dawn-soft" data-a="fade"></div>
      <span class="ghost" data-ghost aria-hidden="true">Stack</span>
      <div class="scene-inner">
        <p class="kicker" data-a="scramble">{String(jobs.length + 3).padStart(2, "0")} · What I do</p>
        <h2 class="headline" data-split="chars">Design. Ship.<br /><span class="accent">Scale.</span></h2>
        <dl class="skills">
          {skills.map((s) => (
            <div data-a="row"><dt>{s.k}</dt><dd>{s.v}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="scene" data-scene="outro" data-hold="0" aria-label="Say hello">
      <div class="dawn" data-a="fade"></div>
      <div class="scene-inner title-inner">
        <p class="kicker" data-a="up">{site.status}</p>
        <h2 class="big-name outro-name" data-split="chars">{site.name}</h2>
        <p class="lede center" data-a="up">{site.role}</p>
        <div class="cta" data-a="up">
          <a href={`mailto:${site.email}`} class="btn-pill">Say hello</a>
          <a href={site.resume} target="_blank" rel="noopener" class="btn-ghost">Resume ↗</a>
          <a href="/" class="btn-ghost">Explore the site</a>
          <button type="button" class="j-replay" data-replay>Replay ↺</button>
        </div>
      </div>
    </section>

    <div class="wipe" aria-hidden="true"><span class="wipe-a"></span><span class="wipe-b"></span></div>
    <a href="/" class="j-close" aria-label="Exit the journey">Esc ✕</a>
    <nav class="j-bar" aria-label="Presentation controls">
      <button type="button" class="j-play" data-toggle aria-label="Pause">❚❚</button>
      <button type="button" class="j-sound" data-sound aria-pressed="false" aria-label="Sound">♪<span class="j-sound-label"> Sound off</span></button>
      <ol class="j-segs">
        {scenes.map((s, i) => (
          <li>
            <button type="button" data-seek={i} aria-label={`Jump to ${s.label}`}>
              <span class="j-fill"></span>
              <span class="j-label">{s.label}</span>
            </button>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</Base>

<style>
  .journey {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    background: #050505;
    color: var(--color-cream);
  }
  .scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    visibility: hidden;
    opacity: 0;
    padding: 1.5rem 1rem 5rem;
    overflow: hidden;
  }
  .scene-sky {
    opacity: 0.55;
  }
  .scene-sky :global(.sky-ridge) {
    height: 26%;
    background: #050505;
  }
  .dawn {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 75% 55% at 50% 105%, rgba(255, 196, 120, 0.5), rgba(214, 102, 48, 0.25) 38%, transparent 72%),
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(60, 72, 140, 0.35), transparent 70%);
  }
  .dawn-soft {
    opacity: 0.6;
  }
  .scene-inner {
    position: relative;
    width: min(1100px, 100%);
  }
  /* Giant outlined word drifting behind each scene. */
  .ghost {
    position: absolute;
    top: 50%;
    left: 0;
    translate: 0 -50%;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62.5%;
    font-variation-settings: "wdth" 62.5;
    text-transform: uppercase;
    font-size: min(42vw, 70svh);
    line-height: 0.8;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(253, 231, 208, 0.09);
    pointer-events: none;
    user-select: none;
  }
  /* Two-layer curtain between scenes: saffron leads, ink follows. */
  .wipe {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .wipe span {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
  }
  .wipe-a {
    background: var(--color-saffron);
  }
  .wipe-b {
    background: #0b0908;
  }
  .title-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .kicker {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.32em;
    font-size: clamp(0.6875rem, 1.3vw, 0.95rem);
    color: rgba(253, 231, 208, 0.8);
  }
  .kicker-end {
    margin-top: 1.25rem;
    color: var(--color-saffron);
  }
  .hi {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    font-size: 1.35em;
    color: var(--color-saffron);
    margin-right: 0.35em;
  }
  .big-name {
    --fs: min(17vw, 20svh);
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62.5%;
    font-variation-settings: "wdth" 62.5;
    font-size: var(--fs);
    line-height: 0.8;
    margin-top: 0.75rem;
  }
  .line {
    display: block;
    overflow: hidden;
    height: calc(var(--fs) * 0.8 * 1.6);
  }
  .line-inner {
    display: inline-block;
    white-space: nowrap;
    transform: scaleY(1.6);
    transform-origin: 50% 0;
  }
  .ch {
    display: inline-block;
  }
  .outro-name {
    --fs: min(10vw, 18svh);
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 0.9;
    margin: 1rem 0 1.25rem;
  }
  .headline {
    font-family: var(--font-heavy);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    margin-top: 0.9rem;
  }
  .accent {
    color: var(--color-saffron);
  }
  .role {
    margin-top: 1rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: clamp(0.7rem, 1.2vw, 0.9rem);
    color: var(--color-saffron);
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 46rem;
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    line-height: 1.55;
    color: rgba(253, 231, 208, 0.78);
  }
  .center {
    margin-inline: auto;
    margin-top: 0;
  }
  /* Supporting copy: the metrics below are the point of a company scene. */
  .summary {
    max-width: 40rem;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: rgba(253, 231, 208, 0.66);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin-top: 2rem;
    max-width: 56rem;
  }
  @media (min-width: 768px) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .metrics dt {
    font-family: var(--font-heavy);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .metrics dd {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.6875rem;
    color: rgba(253, 231, 208, 0.65);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .chips span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(253, 231, 208, 0.3);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
  }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .case-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* 7 tiles: the last spans two columns so neither the 2- nor 4-column grid leaves a hole. */
  .case-grid li:last-child {
    grid-column: span 2;
  }
  .case-grid li {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(5.5rem, 14vh, 8rem);
    padding: 0.9rem 1rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(253, 231, 208, 0.14);
    background:
      radial-gradient(ellipse 70% 90% at var(--sun-x) 120%, rgba(255, 220, 160, 0.55), transparent 70%),
      linear-gradient(180deg, var(--sky-a), var(--sky-b));
    overflow: hidden;
  }
  .case-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62.5%;
    font-variation-settings: "wdth" 62.5;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 3.6vw, 2.75rem);
    line-height: 0.9;
  }
  .case-co {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(253, 231, 208, 0.75);
  }
  .skills {
    margin-top: 2rem;
    display: grid;
    gap: 0.9rem;
    max-width: 52rem;
  }
  .skills div {
    display: grid;
    gap: 0.25rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(253, 231, 208, 0.12);
  }
  @media (min-width: 768px) {
    .skills div {
      grid-template-columns: 14rem 1fr;
      align-items: baseline;
    }
  }
  .skills dt {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    color: var(--color-saffron);
  }
  .skills dd {
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    color: rgba(253, 231, 208, 0.85);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .j-replay {
    flex-basis: 100%;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(253, 231, 208, 0.6);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }
  .j-replay:hover {
    color: var(--color-saffron);
  }

  .j-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0 1rem;
    border: 1px solid rgba(253, 231, 208, 0.25);
    border-radius: 999px;
    color: rgba(253, 231, 208, 0.85);
    background: rgba(0, 0, 0, 0.4);
  }
  .j-close:hover {
    border-color: var(--color-saffron);
    color: var(--color-saffron);
  }
  .j-bar {
    position: absolute;
    left: 50%;
    bottom: clamp(0.75rem, 3vh, 1.5rem);
    transform: translateX(-50%);
    z-index: 2;
    width: min(880px, calc(100% - 2rem));
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .j-play {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(253, 231, 208, 0.3);
    background: rgba(0, 0, 0, 0.45);
    color: var(--color-cream);
    font-size: 0.7rem;
    cursor: pointer;
  }
  .j-sound {
    flex: none;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(253, 231, 208, 0.3);
    background: rgba(0, 0, 0, 0.45);
    color: rgba(253, 231, 208, 0.85);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
  }
  .j-sound[aria-pressed="true"] {
    border-color: var(--color-saffron);
    color: var(--color-saffron);
  }
  .j-segs {
    flex: 1;
    display: flex;
    gap: 0.35rem;
  }
  .j-segs li {
    flex: 1;
  }
  .j-segs button {
    position: relative;
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 1.35rem 0 0;
    cursor: pointer;
    text-align: left;
  }
  .j-segs button::before,
  .j-fill {
    position: absolute;
    top: 0.85rem;
    left: 0;
    height: 3px;
    border-radius: 2px;
  }
  .j-segs button::before {
    content: "";
    right: 0;
    background: rgba(253, 231, 208, 0.18);
  }
  .j-fill {
    width: 0;
    background: var(--color-saffron);
  }
  .j-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    padding-right: 0.5rem;
    text-transform: uppercase;
    color: rgba(253, 231, 208, 0.45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .j-segs button[aria-current="step"] .j-label {
    color: var(--color-cream);
  }
  /* Landscape phones: drop the supporting copy, the zoom fit below handles the rest. */
  @media (max-height: 520px) {
    .scene {
      padding: 0.75rem 1rem 4rem;
    }
    .summary,
    .chips {
      display: none;
    }
    .headline {
      font-size: clamp(2.25rem, 6vw, 3.5rem);
    }
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1.5rem;
      margin-top: 1.25rem;
    }
    .skills div {
      grid-template-columns: none;
      padding-bottom: 0.5rem;
    }
  }
  @media (max-width: 640px) {
    .j-sound {
      width: 44px;
      padding: 0;
    }
    .j-sound-label {
      display: none;
    }
    .skills {
      gap: 0.6rem;
    }
    .skills div {
      padding-bottom: 0.6rem;
    }
    .j-label {
      display: none;
    }
    .metrics dd {
      letter-spacing: 0.1em;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  import { createScore, type Score } from "../lib/journeyScore";

  gsap.registerPlugin(SplitText, ScrambleTextPlugin);

  const SOUND_KEY = "journey-sound";
  const GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

  const parseCount = (text: string) => {
    // Count up only values that start with a plain number, like "3.9M+" or "100+".
    const m = text.match(/^(\d[\d,]*(?:\.\d+)?)(.*)$/);
    if (!m || /^[–\-/→]/.test(m[2])) return null;
    const raw = m[1];
    return { to: Number(raw.replace(/,/g, "")), decimals: raw.split(".")[1]?.length ?? 0, comma: raw.includes(","), suffix: m[2] };
  };

  const start = async () => {
    const root = document.getElementById("journey");
    if (!root) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const scenes = [...root.querySelectorAll<HTMLElement>(".scene")];
    const fills = [...root.querySelectorAll<HTMLElement>(".j-fill")];
    const segs = [...root.querySelectorAll<HTMLButtonElement>("[data-seek]")];
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const soundBtn = root.querySelector<HTMLButtonElement>("[data-sound]")!;
    const [edge, curtain] = root.querySelectorAll<HTMLElement>(".wipe span");

    // Split and measure against the real display font, not the fallback.
    await (document.fonts?.ready ?? Promise.resolve());
    if (!root.isConnected) return;

    // Character and word masks are width-independent, so they survive a resize without re-splitting.
    const splits = reduce
      ? []
      : [...root.querySelectorAll<HTMLElement>("[data-split]")].map((el) =>
          el.dataset.split === "chars"
            ? SplitText.create(el, { type: "words,chars", mask: "chars" })
            : SplitText.create(el, { type: "words", mask: "words" }),
        );
    root.querySelectorAll<HTMLElement>("[data-a='scramble']").forEach((el) => {
      el.dataset.text = el.textContent!.trim();
      el.setAttribute("aria-label", el.dataset.text);
      if (!reduce) el.textContent = "";
    });

    // Shrink a scene that's taller than the space above the control bar instead of clipping it.
    const fit = () =>
      scenes.forEach((s) => {
        const inner = s.querySelector<HTMLElement>(".scene-inner")!;
        inner.style.zoom = "";
        const cs = getComputedStyle(s);
        const avail = s.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
        if (inner.offsetHeight > avail) inner.style.zoom = String(avail / inner.offsetHeight);
      });
    fit();
    window.addEventListener("resize", fit);

    let score: Score | null = null;
    let soundOn = false;
    const tl = gsap.timeline({ paused: true, defaults: { ease: "power3.out" } });

    // One cascade step per element in reading order; groups (tiles, rows, metrics) stagger as one.
    const stage = (scene: HTMLElement, at: string) => {
      const sky = scene.querySelector("[data-a='sky']");
      if (sky) tl.fromTo(sky, { autoAlpha: 0 }, { autoAlpha: 0.55, duration: 1.4, ease: "power2.out" }, at);
      scene.querySelectorAll("[data-a='fade']").forEach((el) =>
        tl.fromTo(el, { autoAlpha: 0, yPercent: reduce ? 0 : 10 }, { autoAlpha: 1, yPercent: 0, duration: 1.3 }, at),
      );
      const ghost = scene.querySelector("[data-ghost]");
      if (ghost) tl.fromTo(ghost, { autoAlpha: 0 }, { autoAlpha: 1, duration: 1.6, ease: "power1.out" }, at);

      const seen = new Set<Element>();
      let pos = at;
      scene.querySelectorAll<HTMLElement>(".scene-inner [data-a], .scene-inner [data-split]").forEach((el) => {
        if (seen.has(el)) return;
        const kind = el.dataset.split && !reduce ? `split-${el.dataset.split}` : el.dataset.a ?? "up";
        const group = ["tile", "row", "metric"].includes(kind)
          ? [...el.parentElement!.children].filter((c) => (c as HTMLElement).dataset.a === kind)
          : [el];
        group.forEach((g) => seen.add(g));

        if (reduce) {
          tl.from(group, { autoAlpha: 0, duration: 0.6, stagger: 0.08 }, pos);
        } else if (kind === "split-chars") {
          tl.from(splits.find((sp) => sp.elements.includes(el))!.chars, { yPercent: 115, duration: 0.9, stagger: 0.028, ease: "expo.out" }, pos);
        } else if (kind === "split-words") {
          tl.from(splits.find((sp) => sp.elements.includes(el))!.words, { yPercent: 110, duration: 0.7, stagger: 0.012, ease: "power3.out" }, pos);
        } else if (kind === "scramble") {
          tl.to(el, { duration: 1, scrambleText: { text: el.dataset.text!, chars: GLYPHS, speed: 0.6, revealDelay: 0.15 }, ease: "none" }, pos);
        } else if (kind === "rise") {
          tl.from(scene.querySelectorAll("[data-a='rise']"), { yPercent: 110, duration: 0.8, stagger: 0.045, ease: "expo.out" }, pos);
          scene.querySelectorAll("[data-a='rise']").forEach((c) => seen.add(c));
        } else if (kind === "tile") {
          tl.from(group, { autoAlpha: 0, y: 60, rotationX: -70, transformPerspective: 900, transformOrigin: "50% 0%", duration: 0.9, stagger: 0.07, ease: "back.out(1.3)" }, pos);
        } else if (kind === "row") {
          tl.from(group, { autoAlpha: 0, x: -48, duration: 0.7, stagger: 0.09 }, pos);
        } else {
          tl.from(group, { autoAlpha: 0, y: 28, duration: 0.8, stagger: 0.1 }, pos);
        }

        if (kind === "metric") {
          group.forEach((m, k) => {
            const dt = m.querySelector<HTMLElement>("[data-count]")!;
            const c = parseCount(dt.textContent!.trim());
            if (!c) return;
            const o = { v: 0 };
            const fmt = (v: number) => (c.comma ? Math.round(v).toLocaleString("en-US") : v.toFixed(c.decimals)) + c.suffix;
            tl.to(o, { v: c.to, duration: 1.3, ease: "power2.out", onUpdate: () => (dt.textContent = fmt(o.v)) }, k === 0 ? "<" : "<0.1");
          });
        }
        pos = ">-0.55";
      });
    };

    scenes.forEach((scene, i) => {
      tl.addLabel(`s${i}`);
      const t0 = tl.duration();
      let at = ">";
      if (i === 0) {
        tl.set(scene, { autoAlpha: 1 });
      } else if (reduce) {
        tl.to(scenes[i - 1], { autoAlpha: 0, duration: 0.4 }).set(scene, { autoAlpha: 1 });
      } else {
        // Alternate the curtain's direction so consecutive scenes don't feel identical.
        const [a, b] = i % 2 ? ["0% 50%", "100% 50%"] : ["100% 50%", "0% 50%"];
        tl.call(() => score?.whoosh())
          .set([edge, curtain], { transformOrigin: a })
          .fromTo([edge, curtain], { scaleX: 0 }, { scaleX: 1, duration: 0.6, ease: "power4.inOut", stagger: 0.08 })
          .set(scenes[i - 1], { autoAlpha: 0 })
          .set(scene, { autoAlpha: 1 })
          .set([edge, curtain], { transformOrigin: b })
          .to([curtain, edge], { scaleX: 0, duration: 0.6, ease: "power4.inOut", stagger: 0.08 });
        at = "<0.2";
      }
      stage(scene, at);
      tl.to({}, { duration: Number(scene.dataset.hold || 0) });

      // Camera drift across the whole scene: a slow push-in on the sky, the ghost word sliding across.
      if (!reduce) {
        const len = tl.duration() - t0 + 1.2;
        const sky = scene.querySelector("[data-a='sky']");
        if (sky) tl.fromTo(sky, { scale: 1.16 }, { scale: 1, duration: len, ease: "power1.out" }, t0);
        const ghost = scene.querySelector("[data-ghost]");
        if (ghost) tl.fromTo(ghost, { xPercent: i % 2 ? 6 : -30 }, { xPercent: i % 2 ? -30 : 6, duration: len, ease: "none" }, t0);
      }
    });

    const starts = scenes.map((_, i) => tl.labels[`s${i}`]);
    const ends = starts.map((s, i) => starts[i + 1] ?? tl.duration());
    let current = -1;
    tl.eventCallback("onUpdate", () => {
      const t = tl.time();
      fills.forEach((f, i) => (f.style.width = `${gsap.utils.clamp(0, 100, ((t - starts[i]) / (ends[i] - starts[i] || 1)) * 100)}%`));
      const idx = starts.findLastIndex((s) => t >= s);
      if (idx !== current) {
        current = idx;
        segs.forEach((b, i) => (i === idx ? b.setAttribute("aria-current", "step") : b.removeAttribute("aria-current")));
        score?.chord(idx);
      }
    });

    const sync = () => {
      const playing = !tl.paused() && tl.progress() < 1;
      toggle.textContent = playing ? "❚❚" : "▶";
      toggle.setAttribute("aria-label", playing ? "Pause" : "Play");
      soundBtn.querySelector(".j-sound-label")!.textContent = soundOn ? " Sound on" : " Sound off";
      soundBtn.setAttribute("aria-pressed", String(soundOn));
    };
    tl.eventCallback("onComplete", sync);

    const enableSound = async () => {
      score ??= createScore();
      if (!score) return;
      score.mute(false);
      soundOn = await score.start();
      if (soundOn) score.chord(Math.max(current, 0));
      sync();
    };
    soundBtn.addEventListener("click", () => {
      if (soundOn) {
        score?.mute(true);
        soundOn = false;
        try { localStorage.setItem(SOUND_KEY, "off"); } catch (_) {}
        sync();
      } else {
        try { localStorage.removeItem(SOUND_KEY); } catch (_) {}
        enableSound();
      }
    });

    const play = () => {
      if (tl.progress() >= 1) tl.restart();
      else tl.play();
      score?.resume();
      sync();
    };
    const pause = () => {
      tl.pause();
      score?.pause();
      sync();
    };
    const seek = (i: number) => {
      tl.play(`s${gsap.utils.clamp(0, scenes.length - 1, i)}`);
      score?.resume();
      sync();
    };

    toggle.addEventListener("click", () => (tl.paused() || tl.progress() >= 1 ? play() : pause()));
    segs.forEach((b) => b.addEventListener("click", () => seek(Number(b.dataset.seek))));
    root.querySelector("[data-replay]")?.addEventListener("click", () => {
      tl.restart();
      score?.resume();
      sync();
    });
    const onKey = (e: KeyboardEvent) => {
      if (e.key === " ") {
        e.preventDefault();
        tl.paused() || tl.progress() >= 1 ? play() : pause();
      } else if (e.key === "ArrowRight") seek(current + 1);
      else if (e.key === "ArrowLeft") seek(current - 1);
      else if (e.key === "Escape") root.querySelector<HTMLAnchorElement>(".j-close")!.click();
    };
    window.addEventListener("keydown", onKey);
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("keydown", onKey);
        window.removeEventListener("resize", fit);
        tl.kill();
        splits.forEach((sp) => sp.revert());
        score?.dispose();
      },
      { once: true },
    );

    tl.play();
    sync();
    // Arriving from the Journey button keeps the click's user activation, so sound can start right away.
    let wantSound = true;
    try { wantSound = localStorage.getItem(SOUND_KEY) !== "off"; } catch (_) {}
    if (wantSound && navigator.userActivation?.hasBeenActive !== false) enableSound();
  };

  document.addEventListener("astro:page-load", start);
</script>
