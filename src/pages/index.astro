---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import CaseStudyCards from "../components/CaseStudyCards.astro";
import EngineeringDomains from "../components/EngineeringDomains.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";

const stages = [
  { id: "hero",         label: "intro" },
  { id: "case-studies", label: "case studies" },
  { id: "domains",      label: "engineering" },
  { id: "timeline",     label: "timeline" },
  { id: "projects",     label: "projects" },
  { id: "contact",      label: "contact" },
];
---

<Base>
  <nav class="stage-nav" aria-label="Section navigation">
    {stages.map((s) => (
      <a href={`#stage-${s.id}`} data-stage-dot={s.id} data-label={s.label} aria-label={s.label}></a>
    ))}
  </nav>

  <div id="stage-hero" class="stage-section" data-theme="hero"><Hero /></div>
  <div id="stage-case-studies" class="stage-section" data-theme="case-studies"><CaseStudyCards /></div>
  <div id="stage-domains" class="stage-section" data-theme="domains"><EngineeringDomains /></div>
  <div id="stage-timeline" class="stage-section" data-theme="timeline"><Timeline /></div>
  <div id="stage-projects" class="stage-section" data-theme="projects"><Projects /></div>
  <div id="stage-contact" class="stage-section" data-theme="contact"><Contact /></div>
</Base>
