---
import Base from "../../layouts/Base.astro";
import { experience } from "../../data/experience";
import { techIconUrl } from "../../lib/techIcons";
import { skies, skyStyle } from "../../data/skies";

export const getStaticPaths = () =>
  experience.map((x) => ({ params: { slug: x.slug }, props: { entry: x } }));

const { entry } = Astro.props;
const [companyName, companyTag] = entry.company.split(/\s*\((.+)\)/);
---

<Base
  title={`${entry.role} at ${entry.company} · Paritosh Tripathi`}
  description={entry.summary}
>
  <header class="max-w-5xl mx-auto px-6 pt-12 pb-10">
    <a
      href="/#timeline"
      class="inline-flex items-center gap-2 label-wide text-[11px] text-[var(--color-ink-muted)] hover:text-[var(--color-saffron)] transition-colors"
    >
      ← all experience
    </a>

    <div class="sys-card page-hero mt-6" style={skyStyle(skies[entry.slug] ?? skies.default)}>
      <div class="sky page-hero-sky" aria-hidden="true"><span class="sky-ridge"></span></div>
      <div class="sys-top">
        <span class="label-wide text-[10px] md:text-xs" transition:name={`exp-${entry.slug}-period`}>
          {entry.period}{entry.location && ` · ${entry.location}`}
        </span>
        {entry.current && <span class="tl-now"><span class="tl-now-dot" />Now</span>}
      </div>
      <div class="sys-body">
        <h1 class="sys-title page-hero-title display-serif" transition:name={`exp-${entry.slug}-company`}>
          {companyName}
          {companyTag && <span class="tl-tag">{companyTag}</span>}
        </h1>
        <div class="tl-role text-2xl md:text-3xl" transition:name={`exp-${entry.slug}-role`}>{entry.role}</div>
        <p class="mt-5 text-lg text-[var(--color-ink-muted)] leading-relaxed max-w-3xl">{entry.summary}</p>

        {
          entry.highlights && (
            <dl class="sys-metrics sys-metrics-wide">
              {entry.highlights.map((h) => (
                <div>
                  <dt>{h.value}</dt>
                  <dd>{h.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </header>

  <article class="max-w-4xl mx-auto px-6 prose-invert pb-12">
    <h2>What I shipped</h2>
    <ul>
      {entry.bullets.map((b) => <li>{b}</li>)}
    </ul>

    <h2>Stack</h2>
    <div
      class="not-prose mt-3 relative overflow-hidden"
      style="mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);"
    >
      <div class="flex w-max gap-2.5 stack-marquee">
        {
          [...entry.stack, ...entry.stack].map((s) => (
            <span class="inline-flex shrink-0 items-center gap-2 font-mono text-xs px-2.5 py-1 rounded-md border border-[var(--color-border)] text-[var(--color-ink-muted)]">
              {techIconUrl(s) && (
                <img src={techIconUrl(s)!} alt="" width="14" height="14" loading="lazy" class="tech-icon" />
              )}
              {s}
            </span>
          ))
        }
      </div>
    </div>

    {
      entry.caseStudies && entry.caseStudies.length > 0 && (
        <>
          <h2>Case studies from this role</h2>
          <div class="not-prose grid md:grid-cols-2 gap-5 mt-6" data-motion-grid>
            {entry.caseStudies.map((c) => {
              const slug = c.href.split("/").pop()!;
              return (
                <a
                  href={c.href}
                  transition:name={`card-${slug}`}
                  class="sys-card"
                  style={skyStyle(skies[slug] ?? skies.default)}
                >
                  <div class="sky mini-sky" aria-hidden="true"><span class="sky-ridge"></span></div>
                  <div class="sys-top">
                    <span class="label-wide text-[10px]">Case study</span>
                    <span class="sys-arrow" aria-hidden="true">↗</span>
                  </div>
                  <div class="sys-body">
                    <h3 class="sys-title display-serif" transition:name={`card-${slug}-title`}>{c.name}</h3>
                    <p class="sys-sub">{c.blurb}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </>
      )
    }
  </article>
  <script>
    import { initCardMotion } from "../../lib/cardMotion";
    initCardMotion();
  </script>
</Base>
