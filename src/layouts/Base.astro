---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideRail from "../components/SideRail.astro";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Paritosh Tripathi — Backend / distributed systems engineer",
  description = "Backend / distributed-systems engineer — Software Engineer II at Sharpsell building a multi-tenant ClickHouse + dbt platform. Previously Parspec and Anakin (YC S21).",
} = Astro.props;

const isHome = Astro.url.pathname === "/";
const introName = "Paritosh Tripathi";
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.classList.add("light");
            document.documentElement.style.colorScheme = "light";
          }
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Noto+Serif+Display:wdth,wght@62.5,900&family=Inter+Tight:wght@700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <title>{title}</title>
    <script is:inline>
      try {
        // Clean up legacy persistent flag (intro now plays once per session).
        localStorage.removeItem("intro_seen_v1");
        if (sessionStorage.getItem("intro_seen_v1")) {
          document.documentElement.classList.add("intro-seen");
        }
      } catch (_) {}
    </script>
  </head>
  <body class="grain min-h-screen">
    <div class="bg-stage" aria-hidden="true">
      <div class="bg-blob bg-blob-1"></div>
      <div class="bg-blob bg-blob-2"></div>
      <div class="bg-blob bg-blob-3"></div>
      <div class="bg-grid"></div>
      <div class="bg-spotlight"></div>
    </div>
    {isHome && (
      <div class="intro" id="intro" role="presentation">
        <div class="intro-panel intro-panel-top" aria-hidden="true"></div>
        <div class="intro-panel intro-panel-bot" aria-hidden="true"></div>
        <div class="intro-stage" aria-hidden="true">
          <div class="intro-dawn"></div>
          <div class="intro-inner">
            <p class="intro-kicker"><span class="intro-hi">पारितोष</span> presents</p>
            <div class="intro-name">
              {introName.split(" ").map((word, w) => (
                <span class="intro-line" aria-hidden="true">
                  <span class="intro-line-inner">
                    {[...word].map((ch, i) => (
                      <span class="intro-ch" style={`--i:${w * 8 + i}`}>{ch}</span>
                    ))}
                  </span>
                </span>
              ))}
            </div>
            <p class="intro-role">Backend · Distributed systems</p>
          </div>
          <div class="intro-foot">
            <span>Est. 2022</span>
            <span class="intro-progress"><span></span></span>
            <span>Click to enter ›</span>
          </div>
        </div>
      </div>
    )}
    <Header />
    <SideRail />
    <div class="shell-main">
      <slot />
      <Footer />
    </div>

    <script>
      // Re-run on every navigation since ClientRouter swaps DOM in place.
      const init = () => {
        document.querySelectorAll<HTMLElement>(".spotlight").forEach((el) => {
          if ((el as any).__spotlightBound) return;
          (el as any).__spotlightBound = true;
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--spotlight-x", `${e.clientX - r.left}px`);
            el.style.setProperty("--spotlight-y", `${e.clientY - r.top}px`);
          });
        });

        // Intro: clean up after curtain finishes; allow click/key to skip.
        const introEl = document.getElementById("intro");
        if (introEl && !document.documentElement.classList.contains("intro-seen")) {
          let cleaned = false;
          const cleanup = () => {
            if (cleaned) return;
            cleaned = true;
            introEl.remove();
            document.documentElement.classList.add("intro-seen");
            try { sessionStorage.setItem("intro_seen_v1", "1"); } catch (_) {}
          };
          introEl.addEventListener("animationend", (e: AnimationEvent) => {
            if (e.target === introEl && e.animationName === "intro-curtain") cleanup();
            if (e.target === introEl && e.animationName === "intro-fade-out") cleanup();
          });
          const skip = () => {
            if (cleaned) return;
            introEl.classList.add("intro-skip");
            window.setTimeout(cleanup, 650);
          };
          introEl.addEventListener("click", skip, { once: true });
          window.addEventListener("keydown", skip, { once: true });
        }

        // Page-level cursor halo for .bg-spotlight. rAF-throttled.
        if (!(window as any).__bgSpotlightBound) {
          (window as any).__bgSpotlightBound = true;
          let rafId = 0;
          let nextX = innerWidth / 2;
          let nextY = innerHeight / 2;
          const root = document.documentElement;
          const apply = () => {
            rafId = 0;
            root.style.setProperty("--cursor-x", `${nextX}px`);
            root.style.setProperty("--cursor-y", `${nextY}px`);
          };
          window.addEventListener(
            "pointermove",
            (e) => {
              nextX = e.clientX;
              nextY = e.clientY;
              if (!rafId) rafId = requestAnimationFrame(apply);
            },
            { passive: true },
          );
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
        );
        document.querySelectorAll(".reveal:not(.is-visible)").forEach((r) => io.observe(r));

        const stages = document.querySelectorAll<HTMLElement>(".stage-section[data-theme]");
        if (stages.length) {
          const dots = document.querySelectorAll<HTMLAnchorElement>(".stage-nav [data-stage-dot]");
          const setActive = (theme: string) => {
            document.documentElement.dataset.theme = theme;
            dots.forEach((d) => {
              d.dataset.active = d.dataset.stageDot === theme ? "true" : "false";
            });
          };
          const stageIO = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  const theme = (e.target as HTMLElement).dataset.theme;
                  if (theme) setActive(theme);
                }
              }
            },
            { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
          );
          stages.forEach((s) => stageIO.observe(s));
          // Set initial theme based on first section in viewport.
          const first = stages[0].dataset.theme;
          if (first) setActive(first);
        } else {
          delete document.documentElement.dataset.theme;
        }
      };

      init();
      document.addEventListener("astro:page-load", init);
    </script>
  </body>
</html>
