# =============================================================================
# Portfolio environment variables
# Copy this file to `.env` (or `.env.local`) and fill in the values you want.
# Both filenames are gitignored.
# =============================================================================

# Optional. Personal-access token for the GitHub REST API.
# Used at build time to avoid the 60-req/hour unauthenticated rate limit.
# Scope: public_repo (read-only). Generate at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Wakatime API key, used at build time only to render the
# "IDE activity" panel on the home page. The key is read in Astro
# frontmatter and never shipped to the client.
#
# Get yours at https://wakatime.com/api-key
# Recommended: generate a read-only key from
# https://wakatime.com/settings/api-keys
WAKATIME_API_KEY=
